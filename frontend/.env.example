# # AWS Cognito Configuration
# VITE_COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXXX
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# # API Configuration
# VITE_API_ENDPOINT=https://your-api-gateway-url.execute-api.eu-west-2.amazonaws.com/prod
# VITE_AWS_REGION=eu-west-2

# # Airtable Embed Configuration
# # Forms Page - Comma-separated list of form configurations in format: id|title|description|embedUrl|category
# # Example: first-timer|First Timer Registration|Register as a first-time visitor|https://airtable.com/embed/appXXX/pagXXX/form|membership
# VITE_AIRTABLE_FORMS=first-timer|First Timer Registration|Register as a first-time visitor to our church|https://airtable.com/embed/xxxxx/form|category

# # Contacts Page - Evangelism contacts interface URL
# VITE_AIRTABLE_CONTACTS_URL=https://airtable.com/embed/xxxxxxx

# # Fallback URLs (optional) - Direct links when embeds fail
# VITE_AIRTABLE_CONTACTS_FALLBACK_URL=https://airtable.com/xxxxxxxx
# VITE_AIRTABLE_FORMS_FALLBACK_URL=https://link.com

