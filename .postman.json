  "performance_test_scenarios": {
    "dashboard_load_test": {
      "name": "Dashboard Load Test",
      "description": "Validate parallel loading performance for main dashboard",
      "iterations": 100,
      "delay": 0,
      "virtual_users": "10-500 (scale gradually)",
      "duration": "5 minutes",
      "target_p95": "2000ms",
      "target_success_rate": "99%"
    },
    "member_journey_load_test": {
      "name": "Member Journey Load Test",
      "description": "Test member-specific queries with parallel Airtable execution",
      "iterations": 50,
      "delay": 100,
      "virtual_users": 100,
      "duration": "3 minutes",
      "target_p95": "2000ms",
      "target_cache_hit_rate": "60%"
    },
    "mixed_workload_test": {
      "name": "Mixed Workload Test",
      "description": "Simulate realistic production traffic with mixed request types",
      "iterations": 200,
      "delay": 50,
      "virtual_users": 250,
      "duration": "10 minutes",
      "target_p95": "2000ms",
      "target_cache_hit_rate": "70%"
    },
    "cache_performance_test": {
      "name": "Cache Performance Test",
      "description": "Validate cache hit (<200ms) and miss (<2000ms) performance",
      "phases": {
        "warm_up": {
          "iterations": 10,
          "delay": 0,
          "virtual_users": 1
        },
        "cache_hit_test": {
          "iterations": 100,
          "delay": 0,
          "virtual_users": 50,
          "target": "200ms average"
        },
        "cache_miss_test": {
          "iterations": 50,
          "delay": 0,
          "virtual_users": 50,
          "target": "2000ms average",
          "note": "Run after 16 minutes to ensure cache expiry"
        }
      }
    },
    "stress_test": {
      "name": "Stress Test (Maximum Capacity)",
      "description": "Determine system breaking point and validate graceful degradation",
      "iterations": 500,
      "delay": 0,
      "virtual_users": "100-1000 (gradual increase)",
      "duration": "15 minutes",
      "targets": {
        "100_users": "1500ms p95, 99% success",
        "250_users": "1800ms p95, 99% success",
        "500_users": "2000ms p95, 99% success (target)",
        "750_users": "2500ms p95, 98% success (graceful degradation)",
        "1000_users": "3000ms p95, 95% success (system limit)"
      }
    }
  },
  "newman_cli_configuration": {
    "installation": "npm install -g newman newman-reporter-html",
    "basic_run": "newman run collection.json -e environment.json --iteration-count 100 --delay-request 0",
    "parallel_execution_500_users": "newman run collection.json -e environment.json --iteration-count 100 --delay-request 0 --parallel 500 --reporters cli,json,html",
    "continuous_testing": "Run every hour with automated result analysis",
    "note": "Newman CLI required for true concurrent load testing (500+ users). Postman UI Collection Runner is limited to sequential execution."
  },
